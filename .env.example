# ========================================
# Facebook 目標 (多個網址用逗號分隔)
# ========================================
FB_TARGET_URLS=https://www.facebook.com/your-target-page-or-profile
FB_TARGET_URLS_NEW_ADD=

# ========================================
# YouTube 目標 (多個網址用逗號分隔)
# ========================================
YT_TARGET_URLS=https://www.youtube.com/@your-target-channel/videos
YT_TARGET_URLS_NEW_ADD=

# ========================================
# Playwright 設定
# ========================================
HEADLESS=true
DELAY_MS=2000
# 設為 chrome 使用系統 Chrome（本機建議），留空則使用 Playwright 內建 Chromium（CI 建議）
BROWSER_CHANNEL=chrome
