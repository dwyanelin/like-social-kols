# ========================================
# Facebook 目標 (多個網址用逗號分隔)
# ========================================
FB_TARGET_URLS=https://www.facebook.com/your-target-page-or-profile
FB_TARGET_URLS_NEW_ADD=

# ========================================
# YouTube 目標 (多個網址用逗號分隔)
# ========================================
YT_TARGET_URLS=https://www.youtube.com/@your-target-channel/videos
YT_TARGET_URLS_NEW_ADD=

# ========================================
# Instagram 目標 (多個網址用逗號分隔)
# ========================================
IG_TARGET_URLS=https://www.instagram.com/your-target-account/
IG_TARGET_URLS_NEW_ADD=

# ========================================
# Threads 目標 (多個網址用逗號分隔)
# ========================================
THREADS_TARGET_URLS=https://www.threads.com/@your-target-account
THREADS_TARGET_URLS_NEW_ADD=

# ========================================
# YouTube 官方 API 模式（三個都填了就會自動改走 API，不再用瀏覽器模擬）
# 取得方式見 README：Google Cloud Console 建立 OAuth 用戶端後執行 pnpm auth:yt
# ========================================
YT_OAUTH_CLIENT_ID=
YT_OAUTH_CLIENT_SECRET=
YT_OAUTH_REFRESH_TOKEN=

# ========================================
# Playwright 設定
# ========================================
# 有頭模式較不易被 Meta 判為自動化；設 true 才無頭（不建議對 Meta 使用）
HEADLESS=false
# 擬人化隨機按讚間隔（毫秒）：在 MIN~MAX 之間隨機取值，取代固定間隔
DELAY_MIN_MS=2000
DELAY_MAX_MS=5000
# 建議設為 chrome 使用真 Google Chrome（指紋較不易被 Meta 偵測）
BROWSER_CHANNEL=chrome
