{
  "name": "like-social-kols",
  "version": "2.0.0",
  "description": "自動對你支持的 KOL 在 Facebook、YouTube、Instagram、Threads 上按讚",
  "main": "index.ts",
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "start": "tsx index.ts",
    "start:meta": "SKIP_YOUTUBE=true tsx index.ts",
    "setup:launchd": "tsx scripts/setupLaunchd.ts",
    "sync-secrets": "tsx scripts/syncSecrets.ts",
    "login-social": "tsx scripts/login.ts",
    "auth:yt": "tsx scripts/youtubeAuth.ts",
    "export-state": "tsx scripts/exportState.ts",
    "like:fb": "tsx scripts/facebook.ts",
    "like:yt": "tsx scripts/youtube.ts",
    "like:yt:api": "tsx scripts/youtubeApi.ts",
    "like:ig": "tsx scripts/instagram.ts",
    "like:threads": "tsx scripts/threads.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "dotenv": "^17.3.1",
    "playwright": "^1.58.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
